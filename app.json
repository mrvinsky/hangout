{
  "expo": {
    "name": "EternalPaws AR",
    "slug": "eternalpaws-ar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0c0814"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "EternalPaws AR, evcil hayvanınızı odanızda canlandırmak için kameranızı kullanır."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0c0814",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    }
  }
}
