# Sunucu tarafı (Vercel → Project Settings → Environment Variables). İstemciye gitmez.
GEMINI_API_KEY=
# İsteğe bağlı, varsayılan: gemini-2.5-flash
GEMINI_MODEL=

# İstemci tarafı (build'e gömülür — gizli bilgi koyma)
# Native uygulamanın WebView'de açacağı web adresi (boşsa Metro dev server kullanılır)
EXPO_PUBLIC_WEB_URL=
# /api/gemini'nin bulunduğu adres (web'de boş bırak = aynı origin; native dev'de Vercel adresini yaz)
EXPO_PUBLIC_API_BASE=
